# Copy this file to .env. Never commit real credentials.
CALENDAR_MODE=mock
PORT=3000
CLINIC_TIME_ZONE=Asia/Manila
GOOGLE_CALENDAR_ID=replace-with-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
SLOT_DURATION_MINUTES=60
LOOKUP_MONTHS_AHEAD=12
